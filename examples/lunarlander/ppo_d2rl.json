{
    "fqn": "rltrain.agents.PPO",
    "gamma": 0.99,
    "tau": 0.005,
    "beta_critic": 0.5,
    "lambda_gae": 0.95,
    "eps_clip": 0.2,
    "num_epochs": 8,
    "minibatch_size": 128,
    "actor": {
        "fqn": "rltrain.networks.D2RLMLP",
        "in_size": 8,
        "out_size": 128,
        "width_size": 128,
        "depth": 4
    },
    "critic": {
        "fqn": "rltrain.networks.D2RLMLP",
        "in_size": 8,
        "out_size": 1,
        "width_size": 128,
        "depth": 4
    },
    "action_head": {
        "fqn": "rltrain.heads.DiscreteHead",
        "feature_dim": 128,
        "action_dim": 4
    },
    "optimizer": {
        "fqn": "optax.adam",
        "learning_rate": 3e-4
    },
    "epoch_terminators": [
        {"fqn": "rltrain.agents.KLEarlyStop", "kl_threshold": 0.05}
    ]
}
