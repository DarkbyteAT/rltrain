{
    "fqn": "rltrain.agents.AdvantageAC",
    "gamma": 0.995,
    "tau": 0.005,
    "beta_critic": 0.5,
    "lambda_gae": 0.95,
    "actor":  {"fqn": "rltrain.networks.MLP", "in_size": 6, "out_size": 64, "width": 64, "depth": 2},
    "critic": {"fqn": "rltrain.networks.MLP", "in_size": 6, "out_size": 1, "width": 64, "depth": 2},
    "action_head": {"fqn": "rltrain.heads.DiscreteHead", "feature_dim": 64, "action_dim": 3},
    "optimizer": {"fqn": "optax.adam", "learning_rate": 3e-4}
}
